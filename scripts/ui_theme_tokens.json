{
  "version": 1,
  "themes": {
    "evening": {
      "selector": ":root",
      "comment": "landing-aligned graphite evening theme defaults",
      "tokens": {
        "font-ui": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "font-mono": "ui-monospace, 'SFMono-Regular', 'Cascadia Code', Consolas, monospace",
        "bg": "#0a0b0c",
        "bg-elevated": "#0e1011",
        "surface": "#131517",
        "surface-2": "#181b1e",
        "surface-hover": "#1f2327",
        "border": "#626970",
        "border-subtle": "#24282d",
        "border-strong": "#78818b",
        "text": "#e8e9eb",
        "text-2": "#a3a8af",
        "text-3": "#8a9098",
        "text-4": "#7d848d",
        "accent": "#d97550",
        "accent-hover": "#e28765",
        "accent-ink": "#0a0b0c",
        "accent-soft": "rgba(217, 117, 80, 0.12)",
        "accent-line": "rgba(217, 117, 80, 0.35)",
        "success": "#6fb37a",
        "success-soft": "rgba(111, 179, 122, 0.12)",
        "danger": "#d96565",
        "danger-soft": "rgba(217, 101, 101, 0.12)",
        "warning": "#d9a850",
        "info": "#6695d9",
        "info-soft": "rgba(102, 149, 217, 0.12)",
        "type-api": "#d9a850",
        "type-ssh": "#6fb37a",
        "type-server": "#6695d9",
        "type-domain": "#b773d9",
        "type-note": "#8d92a0",
        "type-api-icon-bg": "#d9a850",
        "type-api-icon-ink": "#101310",
        "type-ssh-icon-bg": "#6fb37a",
        "type-ssh-icon-ink": "#101310",
        "type-server-icon-bg": "#6695d9",
        "type-server-icon-ink": "#101310",
        "type-domain-icon-bg": "#b773d9",
        "type-domain-icon-ink": "#101310",
        "type-note-icon-bg": "#8d92a0",
        "type-note-icon-ink": "#101310",
        "radius-sm": "6px",
        "radius-md": "10px",
        "radius-lg": "14px",
        "shadow-md": "0 1px 2px rgba(0,0,0,0.4), 0 4px 12px rgba(0,0,0,0.3)",
        "shadow-lg": "0 4px 8px rgba(0,0,0,0.5), 0 16px 32px rgba(0,0,0,0.4)"
      }
    },
    "day": {
      "selector": ":root[data-theme=\"light\"]",
      "comment": "high-contrast daylight companion",
      "tokens": {
        "bg": "#f4f3f1",
        "bg-elevated": "#faf9f7",
        "surface": "#ffffff",
        "surface-2": "#eae9e6",
        "surface-hover": "#dfddd9",
        "border": "#81858a",
        "border-subtle": "#d4d2ce",
        "border-strong": "#70747a",
        "text": "#17191b",
        "text-2": "#45494f",
        "text-3": "#5c6168",
        "text-4": "#62686f",
        "accent": "#aa4528",
        "accent-hover": "#93381f",
        "accent-ink": "#fffaf6",
        "accent-soft": "rgba(170, 69, 40, 0.1)",
        "accent-line": "rgba(170, 69, 40, 0.4)",
        "success": "#2f7540",
        "success-soft": "rgba(47, 117, 64, 0.1)",
        "danger": "#a93636",
        "danger-soft": "rgba(169, 54, 54, 0.1)",
        "warning": "#7b5300",
        "info": "#2f5d99",
        "info-soft": "rgba(47, 93, 153, 0.1)",
        "type-api": "#7b5300",
        "type-ssh": "#2f7540",
        "type-server": "#2f5d99",
        "type-domain": "#704187",
        "type-note": "#5d6269",
        "type-api-icon-bg": "#f1ddaf",
        "type-api-icon-ink": "#624100",
        "type-ssh-icon-bg": "#d0e8d5",
        "type-ssh-icon-ink": "#225f34",
        "type-server-icon-bg": "#d2e2fa",
        "type-server-icon-ink": "#244f86",
        "type-domain-icon-bg": "#ecdaf2",
        "type-domain-icon-ink": "#653c77",
        "type-note-icon-bg": "#e1e4e8",
        "type-note-icon-ink": "#454c54",
        "shadow-md": "0 1px 2px rgba(19,21,23,0.08), 0 6px 18px rgba(19,21,23,0.08)",
        "shadow-lg": "0 4px 10px rgba(19,21,23,0.1), 0 18px 40px rgba(19,21,23,0.12)"
      }
    }
  },
  "targets": {
    "admin": {
      "path": "src/keys_keeper/static/app.css",
      "extensions": {
        "evening": {
          "tokens": {
            "row-pad-y-compact": "6px",
            "row-pad-y-comfortable": "10px",
            "row-pad-y-spacious": "14px",
            "space-pad-compact": "4px",
            "space-pad-comfortable": "8px",
            "space-pad-spacious": "12px"
          }
        }
      }
    },
    "webvault": {
      "path": "src/keys_keeper/webvault/static/app.css",
      "extensions": {
        "evening": {
          "declarations": {
            "color-scheme": "dark"
          }
        },
        "day": {
          "declarations": {
            "color-scheme": "light"
          }
        }
      }
    }
  }
}
