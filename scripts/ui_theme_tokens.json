{
  "version": 1,
  "themes": {
    "evening": {
      "selector": ":root",
      "comment": "warm evening theme defaults",
      "tokens": {
        "font-ui": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "font-mono": "ui-monospace, 'SFMono-Regular', 'Cascadia Code', Consolas, monospace",
        "bg": "#120f0d",
        "bg-elevated": "#191411",
        "surface": "#211a16",
        "surface-2": "#2a211c",
        "surface-hover": "#352a23",
        "border": "#7d6455",
        "border-subtle": "#30261f",
        "border-strong": "#745d4e",
        "text": "#f7efe8",
        "text-2": "#d0c0b4",
        "text-3": "#a69080",
        "text-4": "#8c786a",
        "accent": "#f08a5d",
        "accent-hover": "#f39a73",
        "accent-ink": "#2a1209",
        "accent-soft": "rgba(240, 138, 93, 0.15)",
        "accent-line": "rgba(240, 138, 93, 0.48)",
        "success": "#94b98e",
        "success-soft": "rgba(148, 185, 142, 0.13)",
        "danger": "#e9877e",
        "danger-soft": "rgba(233, 135, 126, 0.13)",
        "warning": "#ddb36b",
        "info": "#91acd2",
        "info-soft": "rgba(145, 172, 210, 0.13)",
        "type-api": "#ddb36b",
        "type-ssh": "#94b98e",
        "type-server": "#91acd2",
        "type-domain": "#c49ad8",
        "type-note": "#aa9a8f",
        "radius-sm": "6px",
        "radius-md": "10px",
        "radius-lg": "14px",
        "shadow-md": "0 8px 24px rgba(0,0,0,0.28)",
        "shadow-lg": "0 18px 55px rgba(0,0,0,0.4)"
      }
    },
    "day": {
      "selector": ":root[data-theme=\"light\"]",
      "tokens": {
        "bg": "#f3eee8",
        "bg-elevated": "#fffdf9",
        "surface": "#ffffff",
        "surface-2": "#eee6dd",
        "surface-hover": "#e5d9ce",
        "border": "#958172",
        "border-subtle": "#ddd2c7",
        "border-strong": "#826e5e",
        "text": "#211914",
        "text-2": "#504137",
        "text-3": "#68574c",
        "text-4": "#78665a",
        "accent": "#b94624",
        "accent-hover": "#a53b1d",
        "accent-ink": "#fffaf6",
        "accent-soft": "rgba(185, 70, 36, 0.11)",
        "accent-line": "rgba(185, 70, 36, 0.42)",
        "success": "#3d7848",
        "success-soft": "rgba(61, 120, 72, 0.1)",
        "danger": "#ad3737",
        "danger-soft": "rgba(173, 55, 55, 0.1)",
        "warning": "#8d620a",
        "info": "#315f9d",
        "info-soft": "rgba(49, 95, 157, 0.1)",
        "type-api": "#9a6812",
        "type-ssh": "#3d7848",
        "type-server": "#315f9d",
        "type-domain": "#74458e",
        "type-note": "#695c54",
        "shadow-md": "0 8px 24px rgba(62, 43, 31, 0.14)",
        "shadow-lg": "0 18px 55px rgba(62, 43, 31, 0.18)"
      }
    }
  },
  "targets": {
    "admin": {
      "path": "src/keys_keeper/static/app.css",
      "extensions": {
        "evening": {
          "tokens": {
            "row-pad-y-compact": "6px",
            "row-pad-y-comfortable": "10px",
            "row-pad-y-spacious": "14px",
            "space-pad-compact": "4px",
            "space-pad-comfortable": "8px",
            "space-pad-spacious": "12px"
          }
        }
      }
    },
    "webvault": {
      "path": "src/keys_keeper/webvault/static/app.css",
      "extensions": {
        "evening": {
          "declarations": {
            "color-scheme": "dark"
          }
        },
        "day": {
          "declarations": {
            "color-scheme": "light"
          }
        }
      }
    }
  }
}
